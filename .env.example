# Pick ONE provider. The app calls an OpenAI-compatible chat API.

# OpenRouter (free models work). Get a key at openrouter.ai/keys.
OPENROUTER_API_KEY=
# Any OpenRouter model id; a free structured-output model is the default.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Or OpenAI directly (used only if OPENROUTER_API_KEY is unset).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# A visitor can also paste their own OpenAI or OpenRouter key in the app's
# Settings; a key starting with sk-or- is routed to OpenRouter automatically.

# Local Ollama (tried first when set). Great for offline testing.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
